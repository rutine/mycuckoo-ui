      <conditionExpression xsi:type="tFormalExpression">${!auditFlowService.hasPass(execution)}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="shortOutGateway_2_to_end_1" name="无人审批直接结束" sourceRef="shortOutGateway_2" targetRef="end">
      <conditionExpression xsi:type="tFormalExpression">${assigneeList_2 == null || assigneeList_2.size() == 0}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="auditGateway_2_to_end_1" name="审批通过结束" sourceRef="auditGateway_2" targetRef="end">
