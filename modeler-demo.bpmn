  <process id="test1001" name="测试审批" isExecutable="true">
    <startEvent id="start" />
    <endEvent id="end" />
    <userTask id="task_3" name="重新申请" flowable:assignee="${initiator}" flowable:formKey="/home">
      <extensionElements>
        <flowable:taskListener event="assignment" expression="${auditFlowService.beforeTask(execution)}" />
      </extensionElements>
    </userTask>
    <exclusiveGateway id="shortOutGateway_0" name="第1级审批人判断" />
    <userTask id="task_0" name="第1级审批(串行会签)" flowable:assignee="${assignee}">
      <extensionElements>
        <flowable:taskListener event="assignment" expression="${auditFlowService.beforeTask(execution)}" />
        <flowable:taskListener event="all" expression="${auditFlowService.on(&#39;test&#39;, task)}" />
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="true" flowable:collection="assigneeList_0" flowable:elementVariable="assignee">
        <completionCondition>${auditFlowService.hasComplete(execution)}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>
    <sequenceFlow id="shortOutGateway_0_to_task_0_1" name="存在审批人" sourceRef="shortOutGateway_0" targetRef="task_0">
      <conditionExpression xsi:type="tFormalExpression">${assigneeList_0 != null &amp;&amp; assigneeList_0.size() &gt; 0}</conditionExpression>
    </sequenceFlow>
    <exclusiveGateway id="auditGateway_0" name="第1级审批结果判断" />
    <sequenceFlow id="task_0_to_auditGateway_0_1" name="提交审批结果" sourceRef="task_0" targetRef="auditGateway_0" />
    <sequenceFlow id="auditGateway_0_to_task_3_1" name="驳回重提" sourceRef="auditGateway_0" targetRef="task_3">
      <conditionExpression xsi:type="tFormalExpression">${!auditFlowService.hasPass(execution)}</conditionExpression>
    </sequenceFlow>
    <exclusiveGateway id="shortOutGateway_1" name="第2级审批人判断" />
    <userTask id="task_1" name="第2级审批(串行会签)" flowable:assignee="${assignee}">
      <extensionElements>
        <flowable:taskListener event="assignment" expression="${auditFlowService.beforeTask(execution)}" />
        <flowable:taskListener event="all" expression="${auditFlowService.on(&#39;test&#39;, task)}" />
